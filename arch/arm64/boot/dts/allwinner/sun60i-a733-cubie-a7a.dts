/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

#include "sun60i-a733.dtsi"

/ {
	model = "Radxa Cubie A7A";
	compatible = "radxa,cubie-a7a", "allwinner,sun60i-a733";

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac0;
		mmc0 = &mmc0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&soc {
	gmac0: ethernet@4500000 {
		compatible = "allwinner,sun60i-a733-gmac210", "snps,dwmac-5.20";
		reg = <0x04500000 0x8000>, <0x04508000 0x1000>;
		interrupts = <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "macirq", "eth_lpi", "tx-queue-0", "rx-queue-0";
		clocks = <&ccu CLK_BUS_GMAC0>, <&ccu CLK_MBUS_GMAC0>,
			 <&ccu CLK_GMAC_PTP>;
		clock-names = "stmmaceth", "mbus", "ptp_ref";
		resets = <&ccu RST_BUS_GMAC0_AXI>, <&ccu RST_BUS_GMAC0>;
		reset-names = "stmmaceth", "ahb";
		phy-handle = <&gmac0_phy>;
		phy-mode = "rgmii";
		tx-internal-delay-ps = <1200>;
		rx-internal-delay-ps = <1000>;
		status = "disabled";

		mdio0: mdio {
			compatible = "snps,dwmac-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			gmac0_phy: ethernet-phy@1 {
				compatible = "ethernet-phy-id7b74.4412";
				reg = <1>;
				max-speed = <1000>;
				reset-gpios = <&pio 7 16 GPIO_ACTIVE_LOW>;
				reset-assert-us = <10000>;
				reset-deassert-us = <150000>;
				eee-broken-100tx;
				eee-broken-1000t;
			};
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb9_pb10_pins>;
	status = "okay";
};
