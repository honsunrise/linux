# FriendlyElec NanoPC-T4 (Rockchip RK3399) config fragment.
#
# Base: the mainline arm64 defconfig in this tree (not the A733/BSP chain).
#   make O=build-nanopc-t4 ARCH=arm64 defconfig
#   make O=build-nanopc-t4 ARCH=arm64 nanopc_t4.config
#
# Check: grep -E '^CONFIG_(MMC_SDHCI_OF_ARASAN|MMC_DW_ROCKCHIP|PCIE_ROCKCHIP_HOST|BRCMFMAC_SDIO|BT_HCIUART|DRM_ROCKCHIP|CPUFREQ_DT|FB|SND)=' \
#            build-nanopc-t4/.config
#
# This profile deliberately uses the upstream Rockchip drivers.  A few
# symbols are re-asserted below because the A733 maintenance fragments
# (bsp.config / radxa_custom.config) disable them and they must not leak
# into a Rockchip build: PWRSEQ_*, SND*, FB, CPUFREQ_DT and CPU_IDLE.

CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_ROCKCHIP=y

# --- Boot storage: eMMC (arasan) --------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_PWRSEQ_EMMC=y

# --- SD card and SDIO Wi-Fi (dw_mmc-rockchip) --------------------------------
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y

# --- NVMe on the M.2 M-key slot (pcie0) --------------------------------------
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_BLK_DEV_NVME=y

# --- SDIO Wi-Fi / Bluetooth (onboard Broadcom module) -----------------------
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y

# --- HDMI / MIPI-DSI and framebuffer console ---------------------------------
CONFIG_DRM=m
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_PANFROST=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- HDMI audio / sound core -------------------------------------------------
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m
CONFIG_SND_SIMPLE_CARD=m

# --- USB 2.0/3.0 and Type-C (FUSB302 port controller) ------------------------
CONFIG_USB_DWC3=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_TYPEC=y
CONFIG_TYPEC=m
CONFIG_TYPEC_FUSB302=m

# --- Gigabit Ethernet (dwmac-rockchip + RTL8211E PHY) -----------------------
CONFIG_STMMAC_ETH=m
CONFIG_DWMAC_ROCKCHIP=m
CONFIG_REALTEK_PHY=y

# --- PMIC, thermal, DVFS and idle -------------------------------------------
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_DRV_RK808=m
CONFIG_ROCKCHIP_THERMAL=m
CONFIG_ROCKCHIP_SARADC=m
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_IDLE=y
