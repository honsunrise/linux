# Allwinner bsp supplies CONFIG_AW_CPUFREQ_DT
# Regular CONFIG_CPUFREQ_DT will break boot
CONFIG_CPUFREQ_DT=n

# Allwinner bsp supplies CONFIG_AW_CPUFREQ_DT_PLATDEV
# Regular CONFIG_CPUFREQ_DT_PLATDEV will break cpufreq driver probe
CONFIG_CPUFREQ_DT_PLATDEV=n

# Allwinner has their own panfrost fork
CONFIG_DRM_PANFROST=n

# We use mainline u-boot/atf that does not support the following features
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=n
CONFIG_CPU_IDLE=n
CONFIG_TEE=n
CONFIG_OPTEE=n

# v7.1 rebase: AW_UART_NG uses circ_buf API for xmit; v7.1 upstream
# migrated UART to kfifo (state->xmit removed from struct uart_state,
# replaced by tty_port.xmit_fifo). Vendor driver needs a substantial
# rewrite to compile. Disable for now — Cubie A7A serial console
# (ttyAS0) becomes unavailable but the box is still reachable over
# Ethernet + SSH after boot. Revisit once the rest of the kernel is
# building.
CONFIG_AW_UART_NG=n
CONFIG_AW_SERIAL_CONSOLE=n
CONFIG_AW_UART_DYNAMIC_DEBUG=n

# v7.1 rebase: struct iommu_domain_ops / iommu_ops fully reshaped —
# attach_dev signature has +1 arg, map/unmap gone, domain_alloc
# renamed to domain_alloc_sva, of_xlate ptr arg is const, pgsize_bitmap
# moved out of iommu_ops, etc. Vendor's sunxi-iommu-v2 needs a major
# rewrite to fit. Disable IOMMU on this build — headless K3s node
# with DMA-capable UFS/GMAC doesn't strictly need SMMU translation
# on A733; drivers fall back to 1:1 direct DMA.
CONFIG_AW_IOMMU=n
CONFIG_AW_IOMMU_V1=n
CONFIG_AW_IOMMU_V2=n

# v7.1 rebase: bsp/drivers/mtd/spi-nor-{5.15,6.1}/core.c reference
# struct spi_nor members (`addr_width`, `page_size`) and macros
# (`SPINOR_OP_RDFSR`, `SPINOR_OP_WREAR`, `XSR_RDY`, `FSR_E_ERR`, ...)
# that upstream renamed/removed by v7.1: `addr_width` → `addr_nbytes`,
# `page_size` moved into per-flash params, half the SPINOR_OP_* macros
# gone. Both 5.15 and 6.1 vendor copies fail identically. seldon-1
# is eMMC-booted; SPI NOR is not in play. Kill AW_MTD entirely so
# neither variant is compiled. Revisit only if a future board needs
# SPI NOR — then port the vendor driver to spi_nor v7.1 API instead
# of carrying the old subtree.
CONFIG_AW_MTD=n

# v7.1 rebase: bsp/drivers/di/drv_div3x/di_driver.c uses `return`
# with a value in a `void` function (v7.1 -Wreturn-mismatch is a
# hard error, not a warning) and references `DMA_BUF` without
# `#include <linux/dma-buf.h>`. Deinterlacer is a video pipeline
# accelerator — seldon-1 is a headless K3s node, no video decode
# path in play. Kill AW_DI; revisit if a display use case appears.
CONFIG_AW_DI=n

# v7.1 rebase: bsp/drivers/vin/utility/vin_os.c hits the same
# `DMA_BUF` undeclared error as AW_DI. VIN is video-input (camera
# CSI / MIPI / ISP / VIPP) — again headless K3s node has no camera.
# Kill AW_VIDEO_SUNXI_VIN; revisit if a camera use case appears.
CONFIG_AW_VIDEO_SUNXI_VIN=n

# v7.1 rebase: bsp/drivers/gpu/panfrost/ is a vendor fork of the
# mainline panfrost driver, targeting a 5.x drm_sched / drm_gem
# API. On v7.1 it fails wholesale — drm_sched_job_init signature
# changed, drm_gem_shmem_madvise removed, drm_driver has no `.date`,
# platform_driver structure churn, etc. Cubie A7A has a Mali GPU
# but seldon-1 is a headless K3s node; we already disable mainline
# DRM_PANFROST for the same reason. Kill AW_DRM_PANFROST too.
CONFIG_AW_DRM_PANFROST=n

# v7.1 rebase: bsp/drivers/drm/panel/{panel-lvds,edp_general_panel}.c
# reference `of_property_read_u32/bool` and `FB_BLANK_UNBLANK` /
# `DRM_INFO` without the necessary includes. LVDS / eDP panels are
# not present on Cubie A7A — the board exposes only HDMI. We keep
# AW_DRM + AW_HDMI so serial-less log recovery over HDMI still
# works (the whole point of the rebase), and cut only the panels
# that don't apply to this board.
CONFIG_AW_DRM_LVDS=n
CONFIG_AW_DRM_EDP=n
CONFIG_AW_DRM_TRILINEAR_EDP14=n
CONFIG_AW_DRM_EDP_CONTROLLER_USED=n
CONFIG_AW_DRM_DP_HDCP=n
CONFIG_PANEL_LVDS_GENERAL=n
CONFIG_PANEL_EDP_GENERAL=n

# v7.1 rebase: bsp/drivers/drm/sunxi_drm_dsi.c uses del_timer_sync
# (renamed timer_delete_sync in v6.15), from_timer (removed in v6.15
# with the container_of switch), and of_find_device_by_node without
# including <linux/of_platform.h>. Cubie A7A exposes only HDMI; no
# DSI panel in play. Kill AW_DRM_DSI + PANEL_DSI_GENERAL.
CONFIG_AW_DRM_DSI=n
CONFIG_PANEL_DSI_GENERAL=n

# v7.1 rebase: bsp/drivers/drm/sunxi_fbdev_core.c uses FB_EVENT_BLANK
# and the fb_notifier_call_chain path, which mainline dropped when
# fbdev migrated fully to the drm client framework. bsp/drivers/drm/
# Makefile switches to sunxi_drmfb_core.o when CONFIG_FB is off — a
# path that avoids the fb_notifier code entirely. Turn FB off; the
# DRM console emulation lives on via drm_client + drm_fb_helper.
CONFIG_FB=n
CONFIG_FRAMEBUFFER_CONSOLE=n

# v7.1 rebase: bsp/drivers/ve/cedar-ve/cedar_ve.c (Allwinner video
# encoder/decoder — h264/mpeg4/mpeg2/vc1/rmvb) hits multiple v6.12+
# API removals: no_llseek was retired (mainline stopped requiring a
# seek stub); vmalloc/vfree no longer transitively included; ioctl
# callbacks changed void return semantics. Headless K3s node doesn't
# use hardware codecs. Kill AW_VIDEO_ENCODER_DECODER; revisit if a
# transcode workload lands here.
CONFIG_AW_VIDEO_ENCODER_DECODER=n
CONFIG_AW_VIDEO_KERNEL_ENC=n
CONFIG_AW_VIDEO_KERNEL_DEC=n

# v7.1 rebase: bsp/drivers/sound/codecs/ac101.c (Allwinner AC101
# audio codec — I2C-attached DAC/ADC) uses SND_SOC_DAIFMT_CBM_CFM /
# SND_SOC_DAIFMT_CBS_CFS naming that mainline renamed to the CBP/CBC
# scheme in v5.16, gpio_is_valid / gpio_request_one / GPIOF_* from
# the pre-descriptor legacy GPIO API (dropped in v6.9), and
# snd_soc_dapm_kcontrol_component (renamed _to_component in v5.13).
# The board has no audio DAC/amp wired for this node's role; kill
# SND_SOC entirely so no vendor codec driver needs porting.
CONFIG_SND=n
CONFIG_SND_SOC=n

# v7.1 rebase: bsp/drivers/pcie/pcie-sunxi-rc.c uses
# pci_msi_create_irq_domain which mainline removed as part of the
# PCI/MSI parent-domain rework (v6.11+); the replacement path uses
# msi_create_parent_irq_domain and requires a substantial rewrite
# of the vendor PCIe root complex driver. seldon-1 boots off eMMC
# and has no NVMe / PCIe device attached; kill AW_PCIE_RC.
CONFIG_AW_PCIE_RC=n
