# Allwinner bsp supplies CONFIG_AW_CPUFREQ_DT
# Regular CONFIG_CPUFREQ_DT will break boot
CONFIG_CPUFREQ_DT=n

# Allwinner bsp supplies CONFIG_AW_CPUFREQ_DT_PLATDEV
# Regular CONFIG_CPUFREQ_DT_PLATDEV will break cpufreq driver probe
CONFIG_CPUFREQ_DT_PLATDEV=n

# v7.1 rebase: bsp/drivers/cpufreq/cpufreq-linux-7.1/cpufreq-dt.c is
# a vendor fork of the mainline cpufreq-dt (selected via VERSION.PATCHLEVEL
# subdir). It hits multiple v6.11+ removals: CPUFREQ_ETERNAL,
# policy_has_boost_freq / cpufreq_enable_boost_support, .exit callback
# void-ification, platform_driver.remove_new. Kill the whole AW_CPUFREQ_DT.
# Runtime consequence: no DVFS driver on A733 — CPU stays at OPP the
# bootloader left it at. Not a functional regression for K3s: kubelet
# doesn't need dynamic frequency scaling.
CONFIG_AW_CPUFREQ_DT=n
CONFIG_AW_CPUFREQ_DT_PLATDEV=n

# v7.1 rebase: bsp/drivers/power/temp_ctrl/*.c dereferences
# power_supply.of_node which was removed (v6.5 uses power_supply.dev.of_node
# or drv_data plumbing instead). AXP8191 PMIC temp-based charge current
# throttling isn't required for this K3s node; disable both vendor drivers.
CONFIG_AW_AXP8191_TEMP_CTRL=n
CONFIG_AW_POWER_TEMP_CTRL=n

# Allwinner has their own panfrost fork
CONFIG_DRM_PANFROST=n

# We use mainline u-boot/atf that does not support the following features
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=n
CONFIG_CPU_IDLE=n
CONFIG_TEE=n
CONFIG_OPTEE=n

# v7.1 rebase: AW_UART_NG uses circ_buf API for xmit; v7.1 upstream
# migrated UART to kfifo (state->xmit removed from struct uart_state,
# replaced by tty_port.xmit_fifo). Vendor driver needs a substantial
# rewrite to compile. Disable for now — Cubie A7A serial console
# (ttyAS0) becomes unavailable but the box is still reachable over
# Ethernet + SSH after boot. Revisit once the rest of the kernel is
# building.
CONFIG_AW_UART_NG=n
CONFIG_AW_SERIAL_CONSOLE=n
CONFIG_AW_UART_DYNAMIC_DEBUG=n

# v7.1 rebase: struct iommu_domain_ops / iommu_ops fully reshaped —
# attach_dev signature has +1 arg, map/unmap gone, domain_alloc
# renamed to domain_alloc_sva, of_xlate ptr arg is const, pgsize_bitmap
# moved out of iommu_ops, etc. Vendor's sunxi-iommu-v2 needs a major
# rewrite to fit. Disable IOMMU on this build — headless K3s node
# with DMA-capable UFS/GMAC doesn't strictly need SMMU translation
# on A733; drivers fall back to 1:1 direct DMA.
CONFIG_AW_IOMMU=n
CONFIG_AW_IOMMU_V1=n
CONFIG_AW_IOMMU_V2=n

# v7.1 rebase: bsp/drivers/mtd/spi-nor-{5.15,6.1}/core.c reference
# struct spi_nor members (`addr_width`, `page_size`) and macros
# (`SPINOR_OP_RDFSR`, `SPINOR_OP_WREAR`, `XSR_RDY`, `FSR_E_ERR`, ...)
# that upstream renamed/removed by v7.1: `addr_width` → `addr_nbytes`,
# `page_size` moved into per-flash params, half the SPINOR_OP_* macros
# gone. Both 5.15 and 6.1 vendor copies fail identically. seldon-1
# is eMMC-booted; SPI NOR is not in play. Kill AW_MTD entirely so
# neither variant is compiled. Revisit only if a future board needs
# SPI NOR — then port the vendor driver to spi_nor v7.1 API instead
# of carrying the old subtree.
CONFIG_AW_MTD=n

# v7.1 rebase: bsp/drivers/di/drv_div3x/di_driver.c uses `return`
# with a value in a `void` function (v7.1 -Wreturn-mismatch is a
# hard error, not a warning) and references `DMA_BUF` without
# `#include <linux/dma-buf.h>`. Deinterlacer is a video pipeline
# accelerator — seldon-1 is a headless K3s node, no video decode
# path in play. Kill AW_DI; revisit if a display use case appears.
CONFIG_AW_DI=n

# v7.1 rebase: bsp/drivers/vin/utility/vin_os.c hits the same
# `DMA_BUF` undeclared error as AW_DI. VIN is video-input (camera
# CSI / MIPI / ISP / VIPP) — again headless K3s node has no camera.
# Kill AW_VIDEO_SUNXI_VIN; revisit if a camera use case appears.
CONFIG_AW_VIDEO_SUNXI_VIN=n

# v7.1 rebase: bsp/drivers/gpu/panfrost/ is a vendor fork of the
# mainline panfrost driver, targeting a 5.x drm_sched / drm_gem
# API. On v7.1 it fails wholesale — drm_sched_job_init signature
# changed, drm_gem_shmem_madvise removed, drm_driver has no `.date`,
# platform_driver structure churn, etc. Cubie A7A has a Mali GPU
# but seldon-1 is a headless K3s node; we already disable mainline
# DRM_PANFROST for the same reason. Kill AW_DRM_PANFROST too.
CONFIG_AW_DRM_PANFROST=n

# v7.1 rebase: bsp/drivers/drm/panel/{panel-lvds,edp_general_panel}.c
# reference `of_property_read_u32/bool` and `FB_BLANK_UNBLANK` /
# `DRM_INFO` without the necessary includes. LVDS / eDP panels are
# not present on Cubie A7A — the board exposes only HDMI. We keep
# AW_DRM + AW_HDMI so serial-less log recovery over HDMI still
# works (the whole point of the rebase), and cut only the panels
# that don't apply to this board.
CONFIG_AW_DRM_LVDS=n
CONFIG_AW_DRM_EDP=n
CONFIG_AW_DRM_TRILINEAR_EDP14=n
CONFIG_AW_DRM_EDP_CONTROLLER_USED=n
CONFIG_AW_DRM_DP_HDCP=n
CONFIG_PANEL_LVDS_GENERAL=n
CONFIG_PANEL_EDP_GENERAL=n

# v7.1 rebase: bsp/drivers/drm/sunxi_drm_dsi.c uses del_timer_sync
# (renamed timer_delete_sync in v6.15), from_timer (removed in v6.15
# with the container_of switch), and of_find_device_by_node without
# including <linux/of_platform.h>. Cubie A7A exposes only HDMI; no
# DSI panel in play. Kill AW_DRM_DSI + PANEL_DSI_GENERAL.
CONFIG_AW_DRM_DSI=n
CONFIG_PANEL_DSI_GENERAL=n

# v7.1 rebase: bsp/drivers/drm/sunxi_fbdev_core.c uses FB_EVENT_BLANK
# and the fb_notifier_call_chain path, which mainline dropped when
# fbdev migrated fully to the drm client framework. bsp/drivers/drm/
# Makefile switches to sunxi_drmfb_core.o when CONFIG_FB is off — a
# path that avoids the fb_notifier code entirely. Turn FB off; the
# DRM console emulation lives on via drm_client + drm_fb_helper.
CONFIG_FB=n
CONFIG_FRAMEBUFFER_CONSOLE=n

# v7.1 rebase: bsp/drivers/ve/cedar-ve/cedar_ve.c (Allwinner video
# encoder/decoder — h264/mpeg4/mpeg2/vc1/rmvb) hits multiple v6.12+
# API removals: no_llseek was retired (mainline stopped requiring a
# seek stub); vmalloc/vfree no longer transitively included; ioctl
# callbacks changed void return semantics. Headless K3s node doesn't
# use hardware codecs. Kill AW_VIDEO_ENCODER_DECODER; revisit if a
# transcode workload lands here.
CONFIG_AW_VIDEO_ENCODER_DECODER=n
CONFIG_AW_VIDEO_KERNEL_ENC=n
CONFIG_AW_VIDEO_KERNEL_DEC=n

# v7.1 rebase: bsp/drivers/sound/codecs/ac101.c (Allwinner AC101
# audio codec — I2C-attached DAC/ADC) uses SND_SOC_DAIFMT_CBM_CFM /
# SND_SOC_DAIFMT_CBS_CFS naming that mainline renamed to the CBP/CBC
# scheme in v5.16, gpio_is_valid / gpio_request_one / GPIOF_* from
# the pre-descriptor legacy GPIO API (dropped in v6.9), and
# snd_soc_dapm_kcontrol_component (renamed _to_component in v5.13).
# The board has no audio DAC/amp wired for this node's role; kill
# SND_SOC entirely so no vendor codec driver needs porting.
CONFIG_SND=n
CONFIG_SND_SOC=n

# v7.1 rebase: bsp/drivers/pcie/pcie-sunxi-rc.c uses
# pci_msi_create_irq_domain which mainline removed as part of the
# PCI/MSI parent-domain rework (v6.11+); the replacement path uses
# msi_create_parent_irq_domain and requires a substantial rewrite
# of the vendor PCIe root complex driver. pcie-sunxi-plat.c is
# shared between RC/EP and uses platform_driver.remove_new (dropped
# in v6.12 when remove reverted to void). seldon-1 boots off eMMC
# and has no NVMe / PCIe device attached; select AW_PCIE_NONE (the
# choice's None arm) which switches obj-y off entirely for both
# host and endpoint object groups.
CONFIG_AW_PCIE_RC=n
CONFIG_AW_PCIE_EP=n
CONFIG_AW_PCIE_NONE=y

# v7.1 rebase: bsp/drivers/stmmac/dwmac-sunxi.c has extensive
# stmmac core API drift — stmmac_probe_config_dt was renamed to
# devm_stmmac_probe_config_dt (v6.10), plat_stmmacenet_data.setup
# callback signature changed platform_device* -> device* (v6.14),
# .mac_interface / .has_gmac / .has_gmac4 fields removed in favor
# of flags, stmmac_bus_clks_config and stmmac_remove_config_dt gone,
# phy_queue_state_machine removed. Full vendor-glue rewrite needed.
# Kill AW_STMMAC_ETH so build advances. Runtime consequence: A733
# GMAC (allwinner,sunxi-gmac-210 / snps,dwmac-5.20) is unsupported
# until the glue is ported; the fallback \"snps,dwmac-5.20\" match
# is the generic dwmac driver which cannot set up A733 clocks/syscon
# on its own, so ethernet is expected non-functional at first boot.
# Follow-up: port dwmac-sunxi.c to the v6.14 stmmac API, or move
# A733 into mainline's dwmac-sun55i (which currently only matches
# a523). This is deferred beyond the \"build a kernel\" goal.
CONFIG_AW_STMMAC_ETH=n

# v7.1 rebase: bsp/drivers/usb/host/ehci-sunxi.c uses `return X;`
# in functions that mainline switched to void (usb_hcd_pltf callback
# reshuffle in v6.13). Vendor OHCI has similar drift. seldon-1 relies
# on the dwc3-based USB3 xhci path (CONFIG_USB_SUNXI_DWC3=y) not the
# vendor EHCI/OHCI glue, so it's safe to disable both here — USB3
# ports keep working via mainline xhci.
CONFIG_USB_EHCI_HCD_SUNXI=n
CONFIG_USB_OHCI_HCD_SUNXI=n
CONFIG_USB_SUNXI_EHCI0=n
CONFIG_USB_SUNXI_EHCI1=n
CONFIG_USB_SUNXI_OHCI0=n
CONFIG_USB_SUNXI_OHCI1=n
CONFIG_USB_SUNXI_HCD=n
CONFIG_USB_SUNXI_HCI=n

# v7.1 rebase: bsp/drivers/usb/dwc3/dwc3-sunxi-plat.c hits
# extensive API drift — phy_init/phy_power_on/phy_set_mode_ext
# take struct phy* not struct phy_provider*; gpio_is_valid /
# gpio_request / gpio_direction_output / gpio_free / gpio_set_value
# from the pre-descriptor legacy GPIO API (dropped in v6.9);
# devm_power_supply_get_by_phandle renamed _by_reference (v6.8);
# of_reset_control_array_get gone (v6.11 devm_-only). It also
# #includes xhci-debug.c which hits struct xhci_hcd.hcs_params1
# renamed hcs_params_read and struct xhci_port.addr removed (v6.9).
# Vendor typec/mux/ps8743.c has the same GPIO API breakage.
# seldon-1 uses mainline xhci-plat + ehci-plat via CONFIG_USB_XHCI_HCD
# and CONFIG_USB_EHCI_HCD_PLATFORM (still =y from bsp.config). Kill
# the vendor DWC3/UDC/TYPEC glue; USB stays functional via mainline.
CONFIG_USB_SUNXI_DWC3=n
CONFIG_DWC3_SUNXI_PLAT=n
CONFIG_PHY_SUNXI_PLAT=n
CONFIG_USB_SUNXI_USB=n
CONFIG_USB_SUNXI_USB_MANAGER=n
CONFIG_USB_SUNXI_USB_DEBUG=n
CONFIG_USB_SUNXI_USB_ADB=n
CONFIG_USB_SUNXI_UDC0=n
CONFIG_USB_SUNXI_TYPEC=n

# Parade PS8743 Type-C mux vendor driver uses the legacy GPIO API
# (gpio_is_valid / gpio_set_value / devm_gpio_request /
# gpio_direction_output) dropped in v6.9. Not present on Cubie A7A.
CONFIG_TYPEC_MUX_PS8743=n

# Allwinner Type-C DP-alt phy switcher: same legacy GPIO breakage
# plus DP_CONF_SIGNALING_DP renamed (v6.14 typec_dp altmode rework)
# plus platform_driver.remove_new dropped v6.12. Not needed on
# Cubie A7A (HDMI-only display output).
CONFIG_TYPEC_MUX_SUNXI_PHY_SWITCHER=n

# v7.1 rebase: bsp/drivers/spi-ng/spi-sunxi.c uses SPI slave-vs-master
# terminology renamed to target-vs-host in v6.11: devm_spi_alloc_slave/
# master, spi_controller.slave_abort, spi_controller_is_slave. Also
# legacy GPIO API (devm_gpio_request) dropped v6.9. Cubie A7A doesn't
# expose SPI to any hardware on seldon-1; kill the whole vendor SPI-NG
# subtree.
CONFIG_AW_SPI_NG=n
CONFIG_AW_SPI_NG_ATOMIC_XFER=n
CONFIG_AW_SPI_SLAVETEST=n

# v7.1 rebase: bsp/drivers/pwm/pwm-sunxi.c hits massive PWM subsystem
# rework — struct pwm_chip.base removed and pwm_chip is now embedded
# (pwm->chip is the struct value directly, not a pointer, so `->` on
# it is now `.`; hundreds of use-sites), pwm_device.chip_data removed
# in favor of pwmchip_get_drvdata. Vendor driver needs a full port.
# Cubie A7A on this node has no PWM consumers wired up (no PWM fan,
# no PWM LED, no PWM backlight); kill AW_PWM.
CONFIG_AW_PWM=n
CONFIG_SENSORS_PWM_FAN=n

# v7.1 rebase: bsp/drivers/input/sensor/msa/msa_cust.c and its
# siblings (stk3x1x, sc7a20, mmc5603, qmi8658, mir3da) hit
# strlcpy removal (v6.9) and hrtimer_init removal (v6.15).
# These are I2C accel/gyro/mag/light chips typical of tablets and
# handhelds — Cubie A7A doesn't wire any of them. Disable the whole
# vendor input-sensor subsystem.
CONFIG_AW_INPUT_SENSOR=n
CONFIG_AW_INPUT_SENSORINIT=n

# v7.1 rebase: bsp/drivers/pm_domain/{pm_domains,pck600_domains}.c
# hit multi-front API drift: from_timer + del_timer_sync removed in
# v6.15 (container_of + timer_delete_sync), of_match_device replaced
# by device_get_match_data (v6.6), missing platform_device.h include
# for struct platform_device incompleteness. SoC power-domain driver
# is only useful for aggressive idle-power savings which K3s doesn't
# need; disable so the build advances.
CONFIG_AW_PM_DOMAINS=n
CONFIG_AW_PCK600_DOMAINS=n
