# Allwinner bsp supplies CONFIG_AW_CPUFREQ_DT
# Regular CONFIG_CPUFREQ_DT will break boot
CONFIG_CPUFREQ_DT=n

# Allwinner bsp supplies CONFIG_AW_CPUFREQ_DT_PLATDEV
# Regular CONFIG_CPUFREQ_DT_PLATDEV will break cpufreq driver probe
CONFIG_CPUFREQ_DT_PLATDEV=n

# Allwinner has their own panfrost fork
CONFIG_DRM_PANFROST=n

# We use mainline u-boot/atf that does not support the following features
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=n
CONFIG_CPU_IDLE=n
CONFIG_TEE=n
CONFIG_OPTEE=n

# v7.1 rebase: AW_UART_NG uses circ_buf API for xmit; v7.1 upstream
# migrated UART to kfifo (state->xmit removed from struct uart_state,
# replaced by tty_port.xmit_fifo). Vendor driver needs a substantial
# rewrite to compile. Disable for now — Cubie A7A serial console
# (ttyAS0) becomes unavailable but the box is still reachable over
# Ethernet + SSH after boot. Revisit once the rest of the kernel is
# building.
CONFIG_AW_UART_NG=n
CONFIG_AW_SERIAL_CONSOLE=n
CONFIG_AW_UART_DYNAMIC_DEBUG=n

# v7.1 rebase: struct iommu_domain_ops / iommu_ops fully reshaped —
# attach_dev signature has +1 arg, map/unmap gone, domain_alloc
# renamed to domain_alloc_sva, of_xlate ptr arg is const, pgsize_bitmap
# moved out of iommu_ops, etc. Vendor's sunxi-iommu-v2 needs a major
# rewrite to fit. Disable IOMMU on this build — headless K3s node
# with DMA-capable UFS/GMAC doesn't strictly need SMMU translation
# on A733; drivers fall back to 1:1 direct DMA.
CONFIG_AW_IOMMU=n
CONFIG_AW_IOMMU_V1=n
CONFIG_AW_IOMMU_V2=n

# v7.1 rebase: bsp/drivers/mtd/spi-nor-{5.15,6.1}/core.c reference
# struct spi_nor members (`addr_width`, `page_size`) and macros
# (`SPINOR_OP_RDFSR`, `SPINOR_OP_WREAR`, `XSR_RDY`, `FSR_E_ERR`, ...)
# that upstream renamed/removed by v7.1: `addr_width` → `addr_nbytes`,
# `page_size` moved into per-flash params, half the SPINOR_OP_* macros
# gone. Both 5.15 and 6.1 vendor copies fail identically. seldon-1
# is eMMC-booted; SPI NOR is not in play. Kill AW_MTD entirely so
# neither variant is compiled. Revisit only if a future board needs
# SPI NOR — then port the vendor driver to spi_nor v7.1 API instead
# of carrying the old subtree.
CONFIG_AW_MTD=n

# v7.1 rebase: bsp/drivers/di/drv_div3x/di_driver.c uses `return`
# with a value in a `void` function (v7.1 -Wreturn-mismatch is a
# hard error, not a warning) and references `DMA_BUF` without
# `#include <linux/dma-buf.h>`. Deinterlacer is a video pipeline
# accelerator — seldon-1 is a headless K3s node, no video decode
# path in play. Kill AW_DI; revisit if a display use case appears.
CONFIG_AW_DI=n

# v7.1 rebase: bsp/drivers/vin/utility/vin_os.c hits the same
# `DMA_BUF` undeclared error as AW_DI. VIN is video-input (camera
# CSI / MIPI / ISP / VIPP) — again headless K3s node has no camera.
# Kill AW_VIDEO_SUNXI_VIN; revisit if a camera use case appears.
CONFIG_AW_VIDEO_SUNXI_VIN=n
