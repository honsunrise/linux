# Radxa Dragon Q6A / CM-Q64 (Qualcomm QCS6490) headless config fragment.
#
# Base: the Radxa Qualcomm defconfig.
#   make O=build-q6a ARCH=arm64 qcom_module_defconfig
#   make O=build-q6a ARCH=arm64 radxa_q6a_headless.config
#
# Check: grep -E '^CONFIG_DRM_MSM(_MDP[45]|_DPU|_DP|_DSI|_HDMI)?=' \
#            build-q6a/.config
# Expect DRM_MSM=m and no enabled display/KMS block.
#
# The Q6A display stack (DP/DPU) has raised a DP interrupt storm on this
# board, so the Q6A/CM-Q64 profile keeps DRM/KMS display blocks disabled
# and only builds the Adreno GPU part of msm.  DRM_MSM_KMS is a hidden
# def_bool selected by MDP4/MDP5/DPU/DP/DSI/HDMI; turning every selector
# off is what keeps KMS=n, so the KMS symbol itself is not listed here.
# This fragment overrides the 7.2 defaults (all display blocks default y).
#
# The shared AIC driver handles the Q6A's USB Wi-Fi module.

CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_AW_BSP is not set
CONFIG_AIC_WLAN_SUPPORT=m
CONFIG_AIC_INTF_USB=y
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC8800_BTUSB_SUPPORT=m

# GPU only: no KMS, no display controller, no DP/DSI/HDMI.
CONFIG_DRM_MSM=m
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_DPU is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_DSI is not set
# CONFIG_DRM_MSM_HDMI is not set
