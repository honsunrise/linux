# Radxa Dragon Q8B (Qualcomm SC8280XP) full-feature config fragment.
#
# Base: the Radxa Qualcomm defconfig shared with Q6A/CM-Q64.
#   make O=build-q8b ARCH=arm64 qcom_module_defconfig
#   make O=build-q8b ARCH=arm64 radxa_q8b.config
#
# Check: grep -E '^CONFIG_(DRM_MSM_(DPU|DP)|SCSI_UFS_QCOM|POWER_SEQUENCING_PCIE_M2|TOSHIBA_TC956X_PCI|DWMAC_TC956X|ATH11K_PCI|ATH12K|MTD_QCOM_SCM_STORAGE|VIDEO_QCOM_IRIS)=' \
#            build-q8b/.config
#
# qcom_module_defconfig is a savedefconfig snapshot.  The 7.2 Kconfig
# defaults every DRM_MSM display block to y and carries no TC956x or M.2
# power-sequencing entries, so both are spelled out explicitly here.

CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# --- Boot storage: UFS -------------------------------------------------------
# UFS is the boot device.  Keep host, platform glue and PHY built in so
# the root filesystem can be mounted without a module tree.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# --- SD card ----------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y

# --- PCIe: two M-key NVMe slots, E-key, TC9563 switch -----------------------
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_BLK_DEV_NVME=y

# M.2 connector power sequencing (drivers/power/sequencing).
CONFIG_POWER_SEQUENCING=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_POWER_SEQUENCING_PCIE_M2=y
CONFIG_PCI_PWRCTRL_GENERIC=y

# --- TC9563 switch and its two TC956x 2.5G Ethernet functions ---------------
# The switch is powered/configured over I2C, its PCI functions register
# auxiliary DWMAC/GPIO devices, and QCA8081 PHYs hang off the EMAC MDIO bus.
CONFIG_PCI_PWRCTRL_TC9563=y
CONFIG_TOSHIBA_TC956X_PCI=m
CONFIG_DWMAC_TC956X=m
CONFIG_STMMAC_ETH=m
CONFIG_GPIO_TC956X=m
CONFIG_QCA808X_PHY=y

# --- USB-C (USB3 + DP altmode) ----------------------------------------------
CONFIG_USB_DWC3=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3_QCOM=m
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_TYPEC=y
CONFIG_TYPEC_MUX_GPIO_SBU=y
CONFIG_USB_ROLE_SWITCH=y

# --- Wi-Fi 6E / Wi-Fi 7 on the E-key slot, and Bluetooth --------------------
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y

# --- QCOM SCM storage (MTD) -------------------------------------------------
CONFIG_MTD=y
CONFIG_MTD_QCOM_SCM_STORAGE=m

# --- Iris video decoder -----------------------------------------------------
CONFIG_MEDIA_SUPPORT=m
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_QCOM_IRIS=m

# --- Display: three DisplayPort outputs, DP2 goes through CH7218A to HDMI ---
CONFIG_DRM=y
CONFIG_DRM_MSM=y
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DP=y
# CONFIG_DRM_MSM_DSI is not set
# CONFIG_DRM_MSM_HDMI is not set
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLE_BRIDGE=y

# --- Audio: WCD9385 over SoundWire on the LPASS macros ----------------------
# SND_SOC_SC8280XP selects SND_SOC_QDSP6 (and its APM/PRM halves), which in
# turn needs the APR/GPR bus.  ADSP parses the topology, CDSP is used by Iris.
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_QCOM_APR=y
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SND_SOC_WCD938X_SDW=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_QCOM_Q6V5_ADSP=m
CONFIG_QCOM_Q6V5_PAS=m
