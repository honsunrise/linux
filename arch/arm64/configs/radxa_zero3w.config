# Radxa ZERO 3W (Rockchip RK3566) config fragment.
#
# Base: the mainline arm64 defconfig in this tree (not the A733/BSP chain).
#   make O=build-z3w ARCH=arm64 defconfig
#   make O=build-z3w ARCH=arm64 radxa_zero3w.config
#
# Check: grep -E '^CONFIG_(MMC_SDHCI_OF_DWCMSHC|MMC_DW_ROCKCHIP|BRCMFMAC_SDIO|BT_HCIUART|DRM_ROCKCHIP|CPUFREQ_DT|FB|SND)=' \
#            build-z3w/.config
#
# This profile deliberately uses the upstream Rockchip drivers.  A few
# symbols are re-asserted below because the A733 maintenance fragments
# (bsp.config / radxa_custom.config) disable them and they must not leak
# into a Rockchip build: PWRSEQ_*, SND*, FB, CPUFREQ_DT and CPU_IDLE.
#
# Use the AIC8800DS2 DTB for current boards and the AP6212 DTB for older ones.
# AIC firmware and UART hciattach are supplied by the operating system.

CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_ROCKCHIP=y
# CONFIG_AW_BSP is not set

# --- Boot storage: eMMC (dwcmshc) -------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_PWRSEQ_EMMC=y

# --- SD card and SDIO Wi-Fi (dw_mmc-rockchip) --------------------------------
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y

# --- SDIO Wi-Fi / Bluetooth --------------------------------------------------
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_AIC_WLAN_SUPPORT=m
CONFIG_AIC_INTF_SDIO=y
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y

# --- HDMI display and framebuffer console ------------------------------------
CONFIG_DRM=m
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_DRM_PANFROST=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- HDMI audio / sound core -------------------------------------------------
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m
CONFIG_SND_SIMPLE_CARD=m

# --- USB 2.0 OTG (Type-C) / USB 3.0 ------------------------------------------
CONFIG_USB_DWC3=y
CONFIG_USB_XHCI_HCD=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=m
CONFIG_TYPEC=m

# --- PMIC, thermal, DVFS and idle -------------------------------------------
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_DRV_RK808=m
CONFIG_ROCKCHIP_THERMAL=m
CONFIG_ROCKCHIP_SARADC=m
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_IDLE=y
