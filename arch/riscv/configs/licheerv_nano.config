# Sipeed LicheeRV Nano (Sophgo SG2002) config fragment.
#
# Base: the mainline riscv defconfig in this tree.
#   make O=build-licheerv ARCH=riscv defconfig
#   make O=build-licheerv ARCH=riscv licheerv_nano.config
#
# This enables the native SG2002 drivers (SD, Ethernet internal ePHY, USB,
# audio, PWM/backlight, thermal, RTC/watchdog, I2C/SPI and touch) plus the
# vendor multimedia stack imported under drivers/staging/sophgo and the
# shared AIC8800 SDIO/UART wireless driver.
#
# AIC firmware and the Bluetooth hciattach helper are supplied by the
# operating system; the kernel only provides the drivers.
#
# Check after configuring:
#   grep -E '^CONFIG_(SOPHGO|AIC|CFG80211|MMC_SDHCI_OF_DWCMSHC|DWMAC_CVITEK|CVITEK_PHY|CV181X_THERMAL|PWM_CV1800|TOUCHSCREEN_GOODIX)=' \
#        build-licheerv/.config

CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# --- SoC, pinctrl, clocks, RTC, power/reset --------------------------------
CONFIG_ARCH_SOPHGO=y
CONFIG_ERRATA_THEAD=y
CONFIG_ERRATA_THEAD_CMO=y
CONFIG_RISCV_ISA_XTHEADVECTOR=y
CONFIG_CLK_SOPHGO_CV1800=y
CONFIG_PINCTRL=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL_SOPHGO_SG2002=y
CONFIG_SOPHGO_CV1800_RTCSYS=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CV1800=y
CONFIG_POWER_RESET_CVITEK=y
CONFIG_MFD_SYSCON=y
CONFIG_SOPHGO_CV1800B_DMAMUX=y
CONFIG_CV1800_MBOX=y
CONFIG_SOPHGO_CV1800B_ADC=y
CONFIG_THERMAL=y
CONFIG_CV181X_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_GPIO_DWAPB=y

# --- Storage: microSD on SD0 and the AIC8800 SDIO card on SD1 --------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_PWRSEQ_SIMPLE=y

# --- Ethernet: SG2002 internal ePHY (E/WE) ---------------------------------
CONFIG_NETDEVICES=y
CONFIG_PHYLIB=y
CONFIG_MDIO_BUS_MUX_MMIOREG=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_CVITEK=y
CONFIG_CVITEK_PHY=y

# --- USB 2.0 OTG (host and composite gadget) -------------------------------
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_SOPHGO_CV1800_USB2=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- Audio: internal I2S/TDM, ADC and DAC codecs ---------------------------
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_CV1800B_TDM=y
CONFIG_SND_SOC_CV1800B_ADC_CODEC=y
CONFIG_SND_SOC_CV1800B_DAC_CODEC=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_DW_AXI_DMAC=y

# --- PWM backlight and framebuffer console ---------------------------------
CONFIG_PWM=y
CONFIG_PWM_CV1800=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- I2C, SPI and touchscreen ----------------------------------------------
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_GPIO=y
CONFIG_SPI=y
CONFIG_SPI_DESIGNWARE=y
CONFIG_SPI_DW_MMIO=y
CONFIG_SPI_GPIO=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_TOUCHSCREEN_HYNITRON_CSTXXX=y
CONFIG_TOUCHSCREEN_HYNITRON_HYN_TS=y

# --- AIC8800 SDIO WiFi and UART Bluetooth (W/WE) ---------------------------
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_AIC_WLAN_SUPPORT=m
CONFIG_AIC_INTF_SDIO=y
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC8800_BTLPM_SUPPORT=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m

# Older Realtek SDIO combo modules enumerate with different IDs from AIC.
CONFIG_RTL8733BS=m
CONFIG_RTK_BTSDIO=m

# --- Sophgo SG200x vendor multimedia drivers -------------------------------
CONFIG_STAGING=y
CONFIG_SOPHGO_VENDOR=y
CONFIG_SOPHGO_ION=m
CONFIG_SOPHGO_OSDRV_SYS=m
CONFIG_SOPHGO_OSDRV_BASE=m
CONFIG_SOPHGO_OSDRV_SNSR_I2C=m
CONFIG_SOPHGO_OSDRV_MIPI_RX=m
CONFIG_SOPHGO_OSDRV_VI=m
CONFIG_SOPHGO_OSDRV_VPSS=m
CONFIG_SOPHGO_OSDRV_DWA=m
CONFIG_SOPHGO_OSDRV_RGN=m
CONFIG_SOPHGO_OSDRV_VO=m
CONFIG_SOPHGO_OSDRV_MIPI_TX=m
CONFIG_SOPHGO_OSDRV_FB=m
CONFIG_SOPHGO_OSDRV_IVE=m
CONFIG_SOPHGO_OSDRV_MON=m
CONFIG_SOPHGO_OSDRV_CLOCK_COOLING=m
CONFIG_SOPHGO_OSDRV_RTOS_CMDQU=m
CONFIG_SOPHGO_OSDRV_FAST_IMAGE=m
CONFIG_SOPHGO_OSDRV_WIEGAND=m
CONFIG_SOPHGO_OSDRV_TPU=m
CONFIG_SOPHGO_OSDRV_VCODEC=m
CONFIG_SOPHGO_OSDRV_JPEG=m
CONFIG_SOPHGO_OSDRV_VC_DRIVER=m
