				irq-gpio = <0x36 0x01 0x02 0x00>;
				jack-det-debouce-time = <0x0f>;
				jack-det-gpio-level = <0x00>;
				jack-det-threshold = <0x01>;
				jack-key-det-debouce-time = <0x02>;
				jack-key-det-threshold = <0x11>;
				jack-key-det-voltage-down = <0x10 0x14>;
				jack-key-det-voltage-hook = <0x17 0x1e>;
				jack-key-det-voltage-up = <0x15 0x16>;
				pcm-bit-first = "MSB";
				phandle = <0x10b>;
				reg = <0x3e>;
				rglt-max = <0x01>;
				rglt0-mode = "PMU";
				rglt0-supply = <0x5d>;
				rglt0-voltage = <0x325aa0>;
				rst-gpio = <0x36 0x01 0x03 0x00>;
				status = "okay";
				sysclk-src = "MCLK";
			};
		};

