		twi@7084000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;
			clock-names = "bus";
			clocks = <0x27 0x11>;
			compatible = "allwinner,sunxi-twi-v101";
			device_type = "s_twi1";
			dma-names = "tx", "rx";
			dmas = <0x39 0x30 0x39 0x30>;
			interrupts = <0x00 0xcc 0x04>;
			no_suspend = <0x01>;
			phandle = <0x191>;
			pinctrl-0 = <0x6b>;
			pinctrl-1 = <0x6c>;
			pinctrl-names = "default", "sleep";
			reg = <0x00 0x7084000 0x00 0x400>;
			resets = <0x27 0x07>;
			status = "okay";
			twi_drv_used = <0x00>;

			rtc@51 {
				#clock-cells = <0x00>;
				clock-output-names = "xin32k";
				compatible = "haoyu,hym8563";
				interrupt-parent = <0x35>;
				interrupts = <0x00 0x03 0x00>;
				reg = <0x51>;
			};
		};

		twi@7085000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;
			clock-names = "bus";
			clocks = <0x27 0x10>;
