		watchdog@2050000 {
			compatible = "allwinner,wdt-v103";
			interrupts = <0x00 0x6a 0x04>;
			phandle = <0x16a>;
			reg = <0x00 0x2050000 0x00 0x20>;
		};
	};

	sys24M_clk {
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "sys24M";
		compatible = "fixed-clock";
		phandle = <0x31>;
	};

	thermal-zones {
		phandle = <0x135>;

		cpub_idle_zone {
			phandle = <0x13f>;
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x15 0x06>;

			cooling-maps {

				map0 {
					contribution = <0x400>;
					cooling-device = <0x21 0x00 0x64 0x22 0x00 0x64>;
					trip = <0x20>;
				};
			};

			trips {
				phandle = <0x140>;

				trip-point@0 {
					hysteresis = <0x7d0>;
					phandle = <0x141>;
					temperature = <0x15f90>;
					type = "passive";
				};

				trip-point@1 {
					hysteresis = <0x7d0>;
					phandle = <0x20>;
					temperature = <0x186a0>;
					type = "passive";
				};
