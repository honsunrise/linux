	vf_mapping_table {
		phandle = <0x12c>;
		table = <0x00 0x00 0x01 0x100 0x11 0x101 0x02 0x200 0x12 0x201 0x03 0x300 0x04 0x400 0x05 0x500 0x06 0x600 0x14 0x401 0x15 0x501>;
